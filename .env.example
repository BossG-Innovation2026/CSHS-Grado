# Copy to .env.local (git-ignored) and adjust.

# Postgres for local development, drizzle-kit, and scripts.
# `npm run db:dev` starts a zero-install local Postgres (PGlite) on this URL.
# With Docker instead: `docker compose up -d` and use the same URL.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/postgres

# Keep 1 with the PGlite dev server (it is a single embedded database and
# parallel connections can mix up replies). With Docker/real Postgres, remove
# this line or set 5.
DATABASE_POOL_MAX=1

# Auth. In production these are Worker secrets/vars, not this file.
BETTER_AUTH_SECRET=dev-secret-change-me-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3000
